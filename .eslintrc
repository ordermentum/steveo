{
  "root": true,
  "extends": [
    "@ordermentum/ordermentum",
    "turbo"
  ],
  "settings": {
    "import/resolver": {
      "typescript": {
        "alwaysTryTypes": true,
        "project": [
          "tsconfig.json",
          "packages/*/tsconfig.json"
        ]
      },
      "node": {
        "extensions": [".js", ".jsx", ".ts", ".tsx"]
      }
    }
  },
  "rules": {
    "@typescript-eslint/no-shadow": "off",
    "turbo/no-undeclared-env-vars": "off"
  },
  "ignorePatterns": [
    "node_modules/",
    "build/",
    "lib/"
  ]
}
