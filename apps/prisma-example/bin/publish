#!/usr/bin/env node
if (!process.env.NODE_ENV) process.env.NODE_ENV = 'development';

const prebuilt = ['testing', 'production'].includes(process.env.NODE_ENV);

if (!prebuilt) {
  // Register the TypeScript loader so ./src can be imported directly
  const { register } = await import('tsx/esm/api');
  register();
}

const { client } = await import(
  prebuilt ? '../lib/client.js' : '../src/client.ts'
);

process.title = 'jobs';

const start = async () => {
  console.log('starting scheduler');

  let count = 0;
  while (count < 100) {
    console.log(`creating job ${count}`);
    await client.job.create({
      data: {
        name: 'example-task',
        nextRunAt: new Date().toISOString(),
        data: {
          count,
        },
        repeatInterval: '',
      },
    });
    count += 1;
  }
};

start().catch(e => {
  console.error(e);
  process.exit();
});
