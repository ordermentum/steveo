{
  "name": "@ordermentum/example-prisma-job-helper",
  "version": "3.0.4",
  "description": "A helper lib for a Sequelize/Postgres backed in-process job queue",
  "main": "lib/index.js",
  "type": "module",
  "types": "lib/index.d.ts",
  "directories": {
    "example": "example",
    "test": "test"
  },
  "files": [
    "lib/*"
  ],
  "scripts": {
    "lint": "yarn eslint 'src/**/*.{ts,js}'",
    "build:coverage": "nyc check-coverage --statements 74 --branches 60 --functions 66 --lines 72",
    "test": "NODE_ENV=test nyc npm run spec",
    "report": "./node_modules/.bin/nyc report --reporter=html",
    "spec": "mocha -R spec --import tsx test/*.ts",
    "spec:runner": "mocha -R spec --import tsx",
    "build": "yarn clean && yarn tsc",
    "clean": "rm -rf lib",
    "reporter": "nyc --reporter=html yarn run test",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ordermentum/steveo.git"
  },
  "keywords": [
    "postgres",
    "job",
    "queue",
    "sequelize"
  ],
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@ordermentum/lunartick": "^0.0.19",
    "@prisma/client": "5.7.1",
    "@steveojs/scheduler-prisma": "*",
    "cron-parser": "^3.5.0",
    "moment-timezone": "^0.6.0",
    "pino": "^10.3.1",
    "typed-emitter": "^1.3.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/chai": "5.2.3",
    "@types/mocha": "8.2.3",
    "@types/moment-timezone": "0.5.30",
    "@types/node": "20.17.28",
    "@types/qs": "6.15.1",
    "@types/sinon": "10.0.20",
    "@types/validator": "13.15.10",
    "chai": "4.5.0",
    "cross-env": "7.0.3",
    "mocha": "12.0.0",
    "nyc": "^18.0.0",
    "prisma": "5.22.0",
    "sinon": "15.2.0",
    "tsx": "^4.23.13",
    "typescript": "5.1.3"
  }
}
