#!/usr/bin/env node
import { writeFile } from 'node:fs/promises';
import path from 'node:path';

if (!process.env.NODE_ENV) process.env.NODE_ENV = 'development';

const prebuilt = ['testing', 'production'].includes(process.env.NODE_ENV);

if (!prebuilt) {
  // Register the TypeScript loader so ./src can be imported directly
  const { register } = await import('tsx/esm/api');
  register();
}

const [{ default: logger }, { default: JobScheduler }] = await Promise.all([
  import(prebuilt ? '../lib/logger.js' : '../src/logger.ts'),
  import(prebuilt ? '../lib/index.js' : '../src/index.ts'),
]);

process.title = 'jobs';

const start = async () => {
  try {
    await JobScheduler.runScheduledJobs();
    logger.info('scheduled jobs are ready to publish messages...');
  } catch (e) {
    logger.error(e);
    process.exit(1);
  }
};

for (const signal of ['SIGTERM', 'SIGINT']) {
  process.on(signal, async () => {
    if (process.env.NODE_ENV === 'development') {
      process.exit();
    }
    logger.info(`Received ${signal}, setting termination lock`);
    await writeFile(path.join(process.cwd(), 'termination.lock'), signal);
  });
}

start();
