{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": [
    ".editorconfig",
    ".eslintrc",
    ".mocharc.js",
    ".nvmrc",
    "tsconfig.eslint.json",
    "tsconfig.json"
  ],
  "pipeline": {
    "build": {
      "dependsOn": [
        "^generate",
        "^build"
      ],
      "outputs": [
        ".next/**"
      ]
    },
    "generate": {
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "lint": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false
    }
  }
}
